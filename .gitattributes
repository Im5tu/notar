# Normalize line endings on checkin, convert to LF on checkout.
* text=auto eol=lf

# Go sources
*.go        text eol=lf diff=golang
go.mod      text eol=lf
go.sum      text eol=lf

# Shell / scripts must stay LF
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf

# Docs / config
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf

# Windows scripts keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary types
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tgz       binary

# Exclude from language stats / archive exports
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.dockerignore   export-ignore
